# ===================================================================
# KONFIGURASI SMART GS PORTAL - PT TELKOM INDONESIA REGIONAL 3
# ===================================================================

# 1. MODE AUTENTIKASI ('simulator' atau 'keycloak')
VITE_AUTH_MODE=keycloak

# 2. KEYCLOAK SSO TELKOM REGIONAL 3 (OIDC PKCE Standard)
VITE_KEYCLOAK_ISSUER=https://auth.treg3.com/realms/smart
VITE_KEYCLOAK_CLIENT_ID=smart-gs
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5173/auth/callback

# 3. TLT SPACE HUB - SUPABASE CLOUD DATABASE
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 4. DIGILETTER - GOOGLE SHEETS DATABASE WEB APP API
VITE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec




