# ===================================================================
# KONFIGURASI SMART GS PORTAL - PT TELKOM INDONESIA REGIONAL 3
# ===================================================================

# 1. MODE AUTENTIKASI ('simulator' atau 'keycloak')
VITE_AUTH_MODE=simulator

# 2. KEYCLOAK SSO CONFIGURATION
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=smart-gs
VITE_KEYCLOAK_CLIENT_ID=smart-gs-frontend

# 3. DATABASE POSTGRESQL (Tentukan user/pass database)
DB_NAME=smart_gs_db
DB_USER=smart_gs_admin
DB_PASSWORD=TelkomRegional3_GS2026!

# 4. GOOGLE OAUTH CREDENTIALS (Dari Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
